# Copy this file to .env. Never commit the populated .env file.
AGENT_MODEL_MODE=stub
NVIDIA_NIM_API_KEY=

# LiteLLM requires the nvidia_nim/ provider prefix.
NVIDIA_MODEL=nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1.5

# NVIDIA-hosted NIM default. Replace this for a private NIM deployment.
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1/

# Leave blank to disable OTLP export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

LANGGRAPH_AGENT_PORT=4202
AGENT_HOST=127.0.0.1
LANGGRAPH_PUBLIC_BASE_URL=http://127.0.0.1:4202
FLIGHT_MCP_URL=http://127.0.0.1:4301/mcp
HOTEL_MCP_URL=http://127.0.0.1:4302/mcp
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1
RATE_LIMIT_WINDOW_SECONDS=60
SIDEBAND_EXTENSION_URI=urn:agent-observability:sideband-events:v1
